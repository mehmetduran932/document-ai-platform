DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

SERVER_PORT=

JWT_SECRET=

# Cloudflare R2 (S3-compatible) - fill these in from the R2 bucket's "Manage API Tokens" page
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_REGION=auto

TESSERACT_LANG=eng
FTS_LANGUAGE=turkish

# 'keyword' (Postgres FTS) or 'embedding' (pgvector, semantic matching). Embeddings try Gemini
# first (free-tier quota), fall back to OpenAI automatically if Gemini errors.
SEARCH_PROVIDER=embedding
EMBEDDING_PROVIDER=
EMBEDDING_CHAIN_ENABLED=
EMBEDDING_PRIMARY_VENDOR=
GEMINI_API_KEY=
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=
VOYAGE_BASE_URL=
RERANKER_ENABLED=
# Which optional docker-compose services actually start. Comma-separated, no spaces. Must include
# 'e5' when EMBEDDING_PROVIDER=e5, and 'reranker' when RERANKER_ENABLED=true - these don't derive
# each other automatically, keep them in sync by hand when you switch modes.
COMPOSE_PROFILES=

# POST /api/ask answer generation
ANSWER_PROVIDER=
CLAUDE_API_KEY=
CLAUDE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
