# Copy to .env and fill in before running `docker compose up`

DB_NAME=document_ai
DB_USERNAME=document_ai
DB_PASSWORD=document_ai
DB_PORT=5432

PGADMIN_EMAIL=admin@document-ai-platform.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

SERVER_PORT=8080

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Cloudflare R2 (S3-compatible) - from the R2 bucket's "Manage API Tokens" page
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=document-ai-platform
R2_REGION=auto

TESSERACT_LANG=eng
# Postgres text-search regconfig; must stay in sync between doc ingestion and query time.
FTS_LANGUAGE=simple

# POST /api/ask answer generation. ANSWER_PROVIDER is 'claude' or 'openai'.
ANSWER_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Only used when ANSWER_PROVIDER=openai. OPENAI_BASE_URL also works against a local
# OpenAI-API-compatible model server (Ollama, LM Studio, vLLM, ...).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
