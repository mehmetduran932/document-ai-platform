# Copy to .env and fill in before running `docker compose up`

DB_NAME=document_ai
DB_USERNAME=document_ai
DB_PASSWORD=document_ai
DB_PORT=5432

PGADMIN_EMAIL=admin@document-ai-platform.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

SERVER_PORT=8080

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Where uploaded document files are stored. 'r2' (default, needs the R2_* vars below) or 'local'
# (LocalFileStorageProvider - keeps files on the local_storage_data docker volume instead, no
# bucket/credentials needed - handy for local dev so you don't need a real R2/S3/MinIO bucket just
# to try the app out).
STORAGE_PROVIDER=r2
# Only used when STORAGE_PROVIDER=local. public-base-url must be reachable by whoever calls the
# download link this produces (the browser locally, or an MCP agent).
LOCAL_STORAGE_PATH=/app/local-storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# Cloudflare R2 (S3-compatible) - from the R2 bucket's "Manage API Tokens" page. Only used when
# STORAGE_PROVIDER=r2.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=document-ai-platform
R2_REGION=auto

TESSERACT_LANG=eng
# Postgres text-search regconfig; must stay in sync between doc ingestion and query time.
FTS_LANGUAGE=simple

# POST /api/ask answer generation. ANSWER_PROVIDER is 'claude' or 'openai'.
ANSWER_PROVIDER=claude
# How long to wait for a full completion before giving up (502 to the caller). Raise this (and any
# reverse-proxy timeouts in front of this app) if you're pointing OPENAI_BASE_URL at a small local
# model on CPU-only hardware - it can legitimately take longer than a cloud API's 120s default.
ANSWER_READ_TIMEOUT_SECONDS=120
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Only used when ANSWER_PROVIDER=openai. OPENAI_BASE_URL also works against a local
# OpenAI-API-compatible model server (Ollama, LM Studio, vLLM, ...).
#
# To test against the local 'ollama' compose service instead of real OpenAI: set
# ANSWER_PROVIDER=openai, OPENAI_BASE_URL=http://ollama:11434/v1, OPENAI_MODEL=qwen2.5:1.5b (or
# whatever tag you've pulled - see the 'ollama' service comment in docker-compose.yml), and add
# 'ollama' to COMPOSE_PROFILES below. Leave OPENAI_API_KEY as your real key if
# EMBEDDING_PROVIDER=fallback also uses the openai vendor - Ollama ignores whatever Bearer token
# it's sent, so there's no collision/downside to reusing it, and you avoid the two-different-things-
# named-OPENAI_API_KEY trap that broke production once (a placeholder like "ollama" here would 401
# the real OpenAI embedding calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

# Semantic search. 'keyword' (Postgres FTS, default) or 'embedding' (pgvector).
SEARCH_PROVIDER=keyword

# Only used when SEARCH_PROVIDER=embedding. EMBEDDING_PROVIDER is 'fallback' (Gemini -> OpenAI ->
# Voyage, in that order) or 'e5' (local multilingual-e5-small, served by the docker-compose
# 'embeddings' service) - mutually exclusive, e5's vector space isn't compatible with the fallback
# trio's.
EMBEDDING_PROVIDER=fallback
# Only relevant when EMBEDDING_PROVIDER=fallback. chain-enabled=false pins to exactly
# EMBEDDING_PRIMARY_VENDOR (gemini|openai|voyage) with no cross-vendor substitution on failure -
# for deployments that want deterministic, fail-loud behavior instead of silent fallback.
EMBEDDING_CHAIN_ENABLED=true
EMBEDDING_PRIMARY_VENDOR=gemini
# 1024, not 1536: Voyage's output_dimension only accepts {256,512,1024,2048}; Gemini/OpenAI both
# truncate to whatever this is set to, so 1024 is the value all three fallback vendors can produce.
EMBEDDING_DIMENSIONS=1024
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Anthropic/Claude has no embeddings API - Voyage AI is who they recommend instead, and is the third
# fallback vendor here.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_BASE_URL=https://api.voyageai.com/v1
# E5_BASE_URL defaults to the compose-network 'embeddings' service; only change it if you're
# running that server elsewhere.
E5_BASE_URL=http://embeddings:80
E5_MODEL=intfloat/multilingual-e5-small

# Cross-encoder reranking of embedding search candidates, served by the docker-compose 'reranker'
# service. Off by default - validate latency/quality on your hardware before enabling.
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://reranker:80

# Which optional docker-compose services actually start (comma-separated, no spaces) - the
# 'embeddings', 'reranker', and 'ollama' services are gated behind matching profiles so they don't
# run (and consume RAM/CPU) on deployments that don't use them. Must include 'e5' when
# EMBEDDING_PROVIDER=e5, 'reranker' when RERANKER_ENABLED=true, and 'ollama' if you're pointing
# OPENAI_BASE_URL at the local ollama service - these don't derive each other automatically, keep
# them in sync by hand when you switch modes. Empty/unset when using EMBEDDING_PROVIDER=fallback
# with RERANKER_ENABLED=false and ANSWER_PROVIDER=claude (or real openai).
# e.g. to try e5 + reranker + local Qwen together on a beefy dev machine: COMPOSE_PROFILES=e5,reranker,ollama
COMPOSE_PROFILES=
